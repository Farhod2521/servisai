# Nusxa oling: cp .env.example .env  — so‘ng qiymatlarni to‘ldiring

# PostgreSQL
POSTGRES_DB=servisai
POSTGRES_USER=servisai
POSTGRES_PASSWORD=servisai

# JWT imzosi uchun uzun tasodifiy satr (masalan: openssl rand -hex 32)
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_DAYS=30

# Sayt manzili (bot "Saytga qaytish" tugmasi uchun) va CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# "Authorized JavaScript origins" ga sayt manzilini qo‘shing (masalan http://localhost:3000)
GOOGLE_CLIENT_ID=

# Telegram: @BotFather dan bot yarating
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Yangi buyurtmalar haqida xabar boradigan chat/guruh ID (ixtiyoriy)
TELEGRAM_ADMIN_CHAT_ID=

# Adminlar (buyurtma statusini o‘zgartira oladi), vergul bilan
ADMIN_EMAILS=
ADMIN_TELEGRAM_IDS=
