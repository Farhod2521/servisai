# Nusxa oling: cp .env.example .env  — so‘ng qiymatlarni to‘ldiring

# Kompyuterda ochiladigan portlar (band bo‘lsa o‘zgartiring, masalan FRONTEND_PORT=3001)
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Portlar qaysi interfeysda ochiladi: 127.0.0.1 — faqat ichkaridan (nginx orqali), 0.0.0.0 — hammaga
BIND_HOST=127.0.0.1

# PostgreSQL
POSTGRES_DB=servisai
POSTGRES_USER=servisai
POSTGRES_PASSWORD=servisai

# JWT imzosi uchun uzun tasodifiy satr (masalan: openssl rand -hex 32)
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_DAYS=30

# Sayt manzili (bot "Saytga qaytish" tugmasi uchun) va CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# "Authorized JavaScript origins" ga sayt manzilini qo‘shing (masalan http://localhost:3000)
GOOGLE_CLIENT_ID=

# Telegram: @BotFather dan bot yarating
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Yangi buyurtmalar va to‘ldirish cheklari keladigan chat/guruh ID (o‘zingizning Telegram ID’ingiz bo‘lishi mumkin)
TELEGRAM_ADMIN_CHAT_ID=

# Hisobni to‘ldirish: mijoz shu kartaga pul o‘tkazib, chek rasmini yuboradi.
# Chek TELEGRAM_ADMIN_CHAT_ID ga "Tasdiqlash / Rad etish" tugmalari bilan boradi (bu sozlanmasa to‘ldirish o‘chiq bo‘ladi).
PAYMENT_CARD_NUMBER=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=Ism Familiya
TOPUP_MIN_AMOUNT=1000

# Adminlar (cheklarni tasdiqlaydi, buyurtma statusini o‘zgartiradi), Telegram ID’lar vergul bilan
ADMIN_EMAILS=
ADMIN_TELEGRAM_IDS=
