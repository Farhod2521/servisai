# Lokal ishga tushirish uchun (docker-compose ildizdagi .env faylidan foydalanadi)
DATABASE_URL=postgresql+asyncpg://servisai:servisai@localhost:5432/servisai
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google Cloud Console -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# @BotFather dan olingan token va bot username (@ belgisiz)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Yangi buyurtmalar haqida xabar boradigan chat (ixtiyoriy)
TELEGRAM_ADMIN_CHAT_ID=

# Hisobni to‘ldirish: mijoz shu kartaga pul o‘tkazib, chek rasmini yuboradi.
# Chek TELEGRAM_ADMIN_CHAT_ID ga "Tasdiqlash / Rad etish" tugmalari bilan boradi (bu sozlanmasa to‘ldirish o‘chiq bo‘ladi).
PAYMENT_CARD_NUMBER=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=Ism Familiya
TOPUP_MIN_AMOUNT=1000

# Vergul bilan ajratilgan adminlar (status o‘zgartirish huquqi)
ADMIN_EMAILS=
ADMIN_TELEGRAM_IDS=
