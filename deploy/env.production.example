# Serverdagi .env uchun namuna:
#   cp deploy/env.production.example .env   — so‘ng <...> joylarini to‘ldiring

# Docker portlari faqat server ichida (127.0.0.1) ochiq, tashqariga nginx chiqaradi.
# Serverda boshqa loyihalar band qilmagan portlarni tanlang (tekshirish: ss -ltnp | grep -E ':3101|:8101')
BIND_HOST=127.0.0.1
FRONTEND_PORT=3101
BACKEND_PORT=8101

# PostgreSQL — parolni albatta o‘zgartiring (masalan: openssl rand -hex 16)
POSTGRES_DB=servisai
POSTGRES_USER=servisai
POSTGRES_PASSWORD=<kuchli-parol>

# Kirish tokenlarini imzolash kaliti — albatta yangisini yarating: openssl rand -hex 32
# (o‘zgartirilsa, hamma foydalanuvchilar qaytadan kirishi kerak bo‘ladi)
SECRET_KEY=<openssl-rand-hex-32>
ACCESS_TOKEN_EXPIRE_DAYS=30

# Sayt manzili: bot tugmalari, do‘st taklif havolalari va CORS uchun
FRONTEND_URL=https://servisai.uz
CORS_ORIGINS=https://servisai.uz

# Google orqali kirish (ixtiyoriy). Google Cloud Console -> Credentials -> OAuth client ->
# "Authorized JavaScript origins" ga https://servisai.uz qo‘shing
GOOGLE_CLIENT_ID=

# Telegram (@BotFather). Diqqat: bitta token bilan bot faqat bitta joyda ishlay oladi —
# serverda ishga tushirganda kompyuteringizdagi botni to‘xtating (docker compose stop bot)
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_BOT_USERNAME=servisai24bot
# Yangi buyurtmalar va to‘ldirish cheklari keladigan chat
TELEGRAM_ADMIN_CHAT_ID=<telegram-id>

# Hisobni to‘ldirish: mijoz shu kartaga pul o‘tkazib, chek yuboradi
PAYMENT_CARD_NUMBER=<8600 ....>
PAYMENT_CARD_HOLDER=<Ism Familiya>
TOPUP_MIN_AMOUNT=1000

# Adminlar (vergul bilan)
ADMIN_TELEGRAM_IDS=1858379541,93758266
ADMIN_EMAILS=
