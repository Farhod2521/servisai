# ─────────────────────────────────────────────────────────────
#  Obunalar boti sozlamalari
#  Bu faylni .env nomi bilan nusxalang va to'ldiring:
#     cp .env.example .env
#  .env fayl HECH QACHON GitHub'ga yuklanmaydi (.gitignore himoyalaydi)
# ─────────────────────────────────────────────────────────────

# ⚠️ MAJBURIY — @BotFather bergan token. Buni hech kimga bermang.
BOT_TOKEN=

# ✅ Admin Telegram ID (raqam). Faqat shu ro'yxatdagilar admin panelga kiradi. O'z ID ingizni botda /id yozib bilasiz.
# Bir nechta bo'lsa vergul bilan: 111111,222222. Birinchisi — to'lov admini (TELEGRAM_OWNER_ID bo'sh bo'lsa).
ADMIN_IDS=93758266

# Yangi mahsulot e'lonlari yuboriladigan kanal (ixtiyoriy).
# Bot o'sha kanalda admin bo'lishi shart. Masalan: -1001234567890
# Yangi obuna/zaxira xabarlari kanalga chiqadi (bot kanalda admin bo'lsin). Bo'sh = yuborilmaydi
ANNOUNCE_CHANNEL_ID=
# true = mijozlarga botdan shaxsiy xabar ham yuboriladi (sukut: false)
ANNOUNCE_TO_USERS=false
# true = kanal postlari bot egasining Premium akkaunti (TG_SESSION) nomidan chiqadi: premium emojilar albatta ko'rinadi.
# Akkaunt kanalda admin bo'lishi kerak (bo'lmasa avtomatik bot orqali yuboriladi). Tekshirish: botda /kanal
ANNOUNCE_VIA_USER=true

# 🔒 Majburiy obuna kanali. Bot o'sha kanalda ADMIN bo'lishi shart.
# Bo'sh = obuna talab qilinmaydi. Bir nechta bo'lsa vergul bilan:
#   FORCE_SUB_CHANNEL=@kanal_username
#   FORCE_SUB_CHANNEL=@kanal1,@kanal2      yoki      -1001234567890
FORCE_SUB_CHANNEL=

# Yordam tugmasida ko'rinadigan username (@ belgisisiz)
SUPPORT_USERNAME=fen1xmedia

# Botning ko'rsatiladigan nomi (bo'sh = o'zgartirilmaydi)
BOT_NAME=

# Baza. Default SQLite — hech narsa o'rnatish shart emas.
# Prod uchun: postgresql+asyncpg://user:pass@localhost:5432/uzshop
DATABASE_URL=sqlite+aiosqlite:///uzshop.db

# Premium (custom) emoji: bot egasida Telegram Premium bo'lsa yetarli. Admin panelda «😀 Premium emoji»
# orqali emojilarni yuborsangiz o'zi yoqiladi (bu o'zgaruvchi endi shart emas).

# ── To'lov provayderlari (keyinroq to'ldiriladi) ──
# Bo'sh qolsa, bot avtomatik "admin orqali qo'lda to'lov" rejimida ishlaydi.
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYMENT_WEBHOOK_HOST=0.0.0.0
PAYMENT_WEBHOOK_PORT=8080

# ── Hosting (Render / VPS) ──
# Bo'sh qoldirsangiz bot kompyuterda polling rejimida ishlaydi.
# Render'da servis manzilini yozing: https://uzshop-bot.onrender.com
WEBHOOK_URL=
# Ixtiyoriy maxfiy so'z — soxta so'rovlardan himoya qiladi
WEBHOOK_SECRET=

# ── Ta'minotchi: canboso (Telegram buyer API) ──
# Kalitni FAQAT shu yerga (Render'da Environment) yozing — GitHub'ga yuklamang.
# Kalit bo'lsa katalog avtomatik to'ldiriladi va xaridlar ta'minotchiga yuboriladi.
CANBOSO_API_KEY=
# Ta'minotchi narxi USD da. 0 = Markaziy bank kursi avtomatik olinadi.
# Qo'lda belgilash uchun masalan: USD_TO_UZS=12000
USD_TO_UZS=0

# ── Ta'minotchi katalogi ──
# Hamkor bergan yopiq JSON API manzili
CATALOG_API_URL=
# Bearer token (agar talab qilinsa)
CATALOG_API_TOKEN=
# Sotuv narxi = ta'minotchi narxi + shu foiz. Masalan 25 = +25%
CATALOG_MARKUP_PERCENT=25
# Narxni yaxlitlash (1000 = eng yaqin ming so'mga)
CATALOG_ROUND_TO=1000
# Avtomatik yangilash oralig'i, daqiqada. 0 = faqat qo'lda
CATALOG_SYNC_MINUTES=3
# Feedda yo'qolgan tovarni o'chirib qo'yish
CATALOG_DEACTIVATE_MISSING=true
# Token qaysi header orqali yuboriladi:
#   auto       - o'zi aniqlaydi (Bearer -> X-API-Key -> Token)
#   bearer     - Authorization: Bearer <token>
#   x-api-key  - X-API-Key: <token>
#   token      - Authorization: Token <token>
#   <nom>      - o'sha nomdagi header
CATALOG_AUTH_STYLE=auto

# ── Avtomatik to'lov (hamyonni to'ldirish) ──
# To'lov administratori — FAQAT shu raqamli Telegram ID (username emas):
TELEGRAM_OWNER_ID=93758266
TELEGRAM_BOT_USERNAME=
# Karta orqali noyob summali to'lov (admin paneldan ham o'zgartiriladi):
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_OWNER=
# CardXabarBot ko'prigi (Telegram user-session; tools/make_session.py bilan yarating). MAXFIY — GitHub'ga yozmang:
TG_API_ID=
TG_API_HASH=
TG_SESSION=
CARD_SOURCES=humocardbot,cardxabarbot
# POST /api/payments/sms uchun majburiy secret:
SMS_WEBHOOK_SECRET=
# Payme: POST /api/payments/payme · Click: POST /api/payments/click/prepare va /complete (kalitlar yuqorida)

# Hisobot boti (BotFather'dan alohida bot): savdo + FOYDA, to'lov, xato, yangi mijoz xabarlari shu bot orqali adminlarga keladi.
# Token FAQAT shu yerda / Render Environment'da. Har bir admin hisobot botida bir marta «Start» bosadi.
ALERT_BOT_TOKEN=
# Ixtiyoriy: qo'shimcha guruh yoki kanal (raqamli ID yoki @username)
ALERT_CHAT_ID=

# Mijozning yopiq kanali: faqat SOTUV va BALANS TO'LDIRISH xabarlari (yangi mijoz xabari yo'q, foyda ko'rsatilmaydi).
# Raqamli kanal ID si (-100…); bot kanalda admin bo'lishi kerak. Bo'sh = o'chiq.
FEED_CHAT_ID=

# ⭐ Telegram Stars va 👑 Premium (StarsUno, starsuno.uz/api). Kalitni FAQAT Render → Environment ga yozing, chatga/GitHub'ga emas.
# Kalit bo'lsa «Obunalar» ro'yxati tagida ⭐ Stars va 👑 Premium tugmalari chiqadi. Ustama foizi: admin panel → ⭐ Stars / Premium.
STARSUNO_KEY=
